{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rohan-caizin/azure-sub-vending-poc/schema/landing-zone.schema.json",
  "title": "Landing-zone request",
  "description": "One file per landing zone: vending/landing-zones/<archetype>/<request-key>.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["location", "tags", "network", "access", "budget", "github"],
  "properties": {
    "location": {
      "type": "string",
      "enum": ["centralindia"]
    },
    "subscription_id": {
      "description": "Optional. Existing subscription to adopt; defaults to the vending variable subscription_id.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "mg_association": {
      "description": "Optional. Set false when several requests share one subscription, so only one of them manages its management group.",
      "type": "boolean"
    },
    "tags": {
      "type": "object",
      "required": ["Environment", "Project", "CostCentre", "Owner"],
      "properties": {
        "Environment": { "type": "string", "enum": ["Dev", "Test", "Prod", "Sandbox"] },
        "Project":     { "type": "string", "pattern": "^[a-z0-9-]{2,40}$" },
        "CostCentre":  { "type": "string", "pattern": "^CC-[A-Z0-9-]+$" },
        "Owner":       { "type": "string", "minLength": 2 }
      },
      "additionalProperties": { "type": "string" }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address_space"],
      "properties": {
        "address_space": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "type": "string", "pattern": "^10\\.20\\.\\d{1,3}\\.0/24$" }
        }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owners_group_object_id"],
      "properties": {
        "owners_group_object_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["monthly_amount", "alert_emails"],
      "properties": {
        "monthly_amount": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "alert_emails": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" }
        }
      }
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization", "repository"],
      "properties": {
        "organization": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" },
        "repository":   { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }
      }
    }
  }
}
